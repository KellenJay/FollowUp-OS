# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Supabase (Step 2) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth.js / Google OAuth (Step 3) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=

# --- Signup gates ---
# Required field on the password-signup form (app/signup). Anyone with the
# public URL could otherwise create a free account with any email/password.
SIGNUP_INVITE_CODE=
# Comma-separated emails allowed to create a NEW account via "Log in with
# Google" — this is the bigger door, since Google sign-in has no field for
# an invite code and otherwise auto-creates an account plus connects a real
# mailbox in one click. Existing accounts are unaffected either way.
GOOGLE_SIGNUP_ALLOWLIST=
# Token encryption key for refresh tokens stored in Supabase — 32 random bytes,
# base64-encoded. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Base URL of this deployment — used to build OAuth redirect/callback URLs.
# http://localhost:3000 for local dev, the Vercel production URL in prod.
APP_URL=http://localhost:3000

# --- OpenAI API (Step 5) ---
OPENAI_API_KEY=
# Configurable so the model can be swapped without a code change.
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic API (eval grader — scripts/eval) ---
# Independent judge model for grading OpenAI outputs (avoids self-grading bias).
# Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=

# --- Azure AI Foundry (eval upload — scripts/eval/foundry_upload.py) ---
# Project endpoint from the Foundry portal -> Project details -> Overview.
# Auth is via azure-identity's DefaultAzureCredential (e.g. `az login`), not
# an API key here.
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=

# --- Misc ---
# Shown on /privacy and /terms as a contact address.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Cron (Step 7) ---
# Vercel sets this automatically for Vercel Cron-triggered requests; also set
# it locally to test cron routes manually.
CRON_SECRET=
